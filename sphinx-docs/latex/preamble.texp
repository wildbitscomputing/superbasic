%%% Typography
% Default line height
\usepackage{setspace}
\setstretch{1}

% Space between paragraphs
\setlength{\parskip}{0.75em}

% Scale main font to 90% to match `notomath`'s default config
\setmainfont{IBMPlexSerif}[
  Path=./,
  Extension=.ttf,
  Scale=0.9,
  UprightFont=*-Regular,
  BoldFont=*-Bold,
  ItalicFont=*-Italic,
  BoldItalicFont=*-BoldItalic,
  Numbers={Monospaced,Lining},
  Ligatures=TeX
]

% Section and chapter styles use \sffamily
\setsansfont{Poppins}[
  Path=./,
  Extension=.ttf,
  Scale=0.9,
  UprightFont=*-Regular,
  BoldFont=*-Bold,
  ItalicFont=*-Italic,
  BoldItalicFont=*-BoldItalic,
  Numbers={Monospaced,Lining},
  FontFace={md}{n}{*-Medium},
  FontFace={md}{it}{*-MediumItalic},
  FontFace={sb}{n}{*-SemiBold},
  Ligatures=TeX
]

% Style running page headers and footers
\makeatletter
\fancyheadinit{%
  \renewcommand{\py@HeaderFamily}{\sffamily\fontseries{sb}\selectfont}%
}
\fancyfootinit{%
  \renewcommand{\py@HeaderFamily}{\sffamily\fontseries{sb}\selectfont}%
}
\makeatother

\setmonofont{IBMPlexMono}[
  Path=./,
  Scale=0.9,
  Extension=.ttf,
  UprightFont=*-Regular,
  BoldFont=*-SemiBold,
  ItalicFont=*-Italic,
  BoldItalicFont=*-SemiBoldItalic,
  FontFace={sb}{n}{*-SemiBold},
  FontFace={sb}{it}{*-SemiBoldItalic}
]

% IBM Plex Mono does not include U+2423, which Sphinx uses to mark a wrapped
% space in verbatim output; use a math-font symbol instead
\sphinxsetup{verbatimvisiblespace={\textcolor{red}{\ensuremath{\sqcup}}}}

% Render front-matter chapters without changing the chapter or page counters
\newcommand{\sphinxunnumberedchapter}[1]{%
  \chapter*{#1}%
  \phantomsection%
  \addcontentsline{toc}{chapter}{#1}%
  \markboth{#1}{#1}%
}

% Render code blocks without a background, border, or shadow
\sphinxsetup{%
  verbatimwithframe=false,%
  pre_background-TeXcolor={white},%
  pre_border-width=0pt,%
  pre_border-radius=0pt,%
  pre_box-shadow=none,%
  pre_padding=0pt%
}

% Indent code blocks
\AddToHook{env/sphinxVerbatim/before}[code-block-indent]{%
  \begin{adjustwidth}{1em}{0pt}%
  \ifx\sphinxVerbatimTitle\empty\else
    \def\sphinxtablecapwidth{\linewidth}%
    \captionsetup{
      labelformat=nolabel,
      format=referenceexample,
      justification=raggedright,
      singlelinecheck=false,
      font=referenceexample,
    }%
  \fi
}
\AddToHook{env/sphinxVerbatim/after}{%
  \end{adjustwidth}%
}

\ChNumVar{\color{primary}\fontsize{76}{80}\usefont{OT1}{pzc}{m}{n}\selectfont}
\ChTitleVar{\color{primary}\raggedleft\Huge\sffamily\bfseries}

\setlength{\parindent}{0pt}
\allsectionsfont{\color{primary}\sffamily\fontseries{sb}\selectfont}
\newcommand{\microsec}{$\mu$s}
\newcommand{\example}[1]{\subsection*{Example: #1}}
\newcommand{\stab}{\hspace*{0.8em}}
\newcommand{\refentry}[1]{
  \section*{#1}
  \addcontentsline{toc}{section}{#1}
}
\newcommand{\refentrycompact}[1]{
  \vspace{-1.4em}
  \refentry{#1}
}
\newenvironment{entry}{%
  \begin{adjustwidth}{4em}{0pt}
}{%
  \end{adjustwidth}
}

%%% Reference entries styling

% Disable section numbering
\newif\ifreferenceentrybody
\newenvironment{referenceentries}{%
  \edef\referenceentriessecnumdepth{\number\value{secnumdepth}}%
  \setcounter{secnumdepth}{0}%
  \renewcommand{\sphinxliteralblockneedspace}{0pt}%
  \referenceentrybodyfalse
  \let\referenceentrysection\section
  \renewcommand{\section}[1]{%
    \ifreferenceentrybody\end{entry}\fi
    \referenceentrysection{##1}%
    \begin{entry}%
    \referenceentrybodytrue
  }%
}{%
  \ifreferenceentrybody\end{entry}\fi
  \setcounter{secnumdepth}{\referenceentriessecnumdepth}%
}

% Prefix code blocks in ref entries with an "Example" label
\AddToHook{env/sphinxVerbatim/before}[reference-example-label]{%
  \ifreferenceentrybody
    \sphinxSetupCaptionForVerbatim{Example}%
  \fi
}
\DeclareHookRule{env/sphinxVerbatim/before}%
  {reference-example-label}{before}{code-block-indent}

%%% Admonitions
\tcbset{admonition/.style={
  colframe=riverblue!10,
  colback=riverblue!10,
  colbacktitle=riverblue!10,
  coltitle=primary,
  boxrule=1pt,
  toptitle=6pt,
  bottomtitle=0pt,
  top=0pt,
  enhanced,
  before skip=1em,
  fonttitle=\small\sffamily\fontseries{sb}\selectfont,
  before upper={\setlist[itemize]{itemsep=5pt,left=3pt,label=--}},
}}

