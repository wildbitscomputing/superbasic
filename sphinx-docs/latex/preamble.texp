\newtcolorbox{defaultnote}[2][]{
  admonition,
  title={\noteicon[0.5]{primary}\hspace{1mm} \MakeUppercase{#2}},
  #1
}

% Map admonition types to their corresponding implementations
\newcount\superbasicadmonitionstyle
\renewenvironment{sphinxadmonition}[2]{%
  \def\superbasicadmonitiontype{#1}%
  \ifdefstring{\superbasicadmonitiontype}{implementation}{%
    \superbasicadmonitionstyle=1\relax
    \begin{implnote}{#2}%
  }{\ifdefstring{\superbasicadmonitiontype}{summary}{%
    \superbasicadmonitionstyle=2\relax
    \begin{summarynote}{#2}%
  }{\ifdefstring{\superbasicadmonitiontype}{compatibility}{%
    \superbasicadmonitionstyle=3\relax
    \begin{compatibilitynote}{#2}%
  }{\ifdefstring{\superbasicadmonitiontype}{caution}{%
    \superbasicadmonitionstyle=4\relax
    \begin{cautionnote}{#2}%
  }{%
    \superbasicadmonitionstyle=5\relax
    \begin{defaultnote}{#2}%
  }}}}%
}{%
  \ifcase\superbasicadmonitionstyle
  \or\end{implnote}%
  \or\end{summarynote}%
  \or\end{compatibilitynote}%
  \or\end{cautionnote}%
  \or\end{defaultnote}%
  \fi
}

\tcbset{tt box/.style={
  on line,
  boxrule=0pt,
  boxsep=1.8pt,
  colback=primary!8,
  colframe=primary!8,
  arc=3pt,
  left=0pt,
  right=0pt,
  top=0.5pt,
  bottom=0.5pt
}}

\newtcbox{\ttbox}{tt box}
\newcommand{\code}[1]{\hspace{0.1em}\ttbox{\ttfamily#1}\hspace{0.1em}}
\newcommand{\kwd}[1]{\code{\color{keyword_color}\bfseries#1}}
\newcommand{\asm}[1]{\code{\color{asm_color}\bfseries#1}}
\newcommand{\keybd}[1]{\hspace{0.1em}\ttbox{\ttfamily#1}\hspace{0.1em}}
\newtcbox{\screenout}{
  enhanced,
  boxrule=0pt,
  frame hidden,
  colback=white,
  fontupper=\ttfamily,
  before skip=1em,
  after skip=1em,
  left=1.6em,
  right=2.4em,
  top=1.2em,
  bottom=0.6em,
  sharp corners,
  rounded corners=northwest,
  arc=3pt,
  boxsep=0pt,
  valign=center,
  interior style={top color=silver!18,bottom color=white,left color=silver!18,right color=white},
  overlay={
    \draw[color=silver!65, line width=0.8pt, rounded corners=3pt]
      ([xshift=0.8pt,yshift=0.8pt]frame.south west) --
      ([xshift=0.8pt,yshift=-0.8pt]frame.north west) --
      ([xshift=-0.8pt,yshift=-0.8pt]frame.north east);
  }}

\lstdefinelanguage{BASIC}{
  morekeywords={
    ABS, ALLOC, ASC, CHR\$, EVENT, FALSE, FRAC,
    GET\$, GET, GETDATE\$, GETTIME\$, HIT, INKEY\$, INKEY, INT, ISVAL,
    ITEMCOUNT, ITEMGET\$, JOYB, JOYX, JOYY, KEYDOWN, LEFT\$, LEN,
    MAX, MID\$, MIN, NOT, PEEK, PEEKD, PEEKL, PEEKW, PLAYING,
    RANDOM, RIGHT\$, RND, SGN, SPC, STR\$, TILE, TIMER, TRUE, VAL,
    FOR, IF, PROC, REPEAT, WHILE, ENDIF, ENDPROC, NEXT, THEN, UNTIL,
    WEND, AT, BY, CALL, CIRCLE, CLEAR, COLOR, COLOUR, DATA, DIM,
    DOWNTO, ELSE, FROM, GFX, HERE, IMAGE, LET, LINE, LOCAL, MEMCOPY,
    OFF, ON, OUTLINE, PALETTE, PLOT, POKE, POKED, POKEL, POKEW, READ,
    RECT, REM, SOLID, SOUND, SPRITE, TEXT, TO,
    ASSEMBLE, ASSERT, BITMAP, BLOAD, BSAVE, CLS,
    CPRINT, CURSOR, DIR, DRIVE, END, EXPLODE, GO, GOSUB, GOTO, HIMEM,
    INPUT, LIST, LOAD, MDELTA, MOUSE, NEW, OPTION, PING, PRINT, RESTORE,
    RETURN, RUN, SAVE, SETDATE, SETTIME, SHOOT, SPRITES, STOP, TILE,
    TILES, TRY, VERIFY, XGO, XLOAD, ZAP,
    ADC, AND, ASL, BCC, BCS, BEQ, BIT, BMI, BNE,
    BPL, BRA, BRK, BVC, BVS, CLC, CLD, CLI, CLV, CMP, CPX, CPY,
    DEC, DEX, DEY, EOR, INC, INX, INY, JMP, JSR, LDA, LDX, LDY,
    LSR, NOP, ORA, PHA, PHP, PHX, PHY, PLA, PLP, PLX, PLY, ROL,
    ROR, RTI, RTS, SBC, SEC, SED, SEI, STA, STP, STX, STY, STZ,
    TAX, TAY, TRB, TSB, TSX, TXA, TXS, TYA,
  },
  sensitive=false,
  morecomment=[l]{REM},
  morecomment=[l]{'},
  morestring=[b]",
}

% Figure captions styling
\DeclareCaptionFont{figurecaption}{%
  \sffamily\fontseries{md}\selectfont%
}
\captionsetup[figure]{
  font={small,figurecaption},
}

\DeclareCaptionLabelFormat{nolabel}{}
\DeclareCaptionFormat{referenceexample}{\hspace*{-1em}#3}
\DeclareCaptionFont{referenceexample}{%
  \small\sffamily\fontseries{md}\itshape\selectfont\color{primary}%
}
\captionsetup[lstlisting]{
  labelformat=nolabel,
  justification=raggedright,
  singlelinecheck=false,
  margin=4em,
  font=it,
}

\lstnewenvironment{lst}
  {\lstset{
     language=BASIC,
     basicstyle=\fontsize{10pt}{11pt}\selectfont\ttfamily,
     keywordstyle=\color{primary}\bfseries,
     commentstyle=\color{darkgray}\itshape\sffamily,
     stringstyle=\color{raspberry}\ttfamily,
     breaklines=true,
     breakatwhitespace=false,
     xleftmargin=1em,
     showstringspaces=false
   }}
  {}

\lstnewenvironment{lstexample}
  {\lstset{
     language=BASIC,
     basicstyle=\fontsize{10pt}{11pt}\selectfont\ttfamily,
     keywordstyle=\color{primary}\bfseries,
     commentstyle=\color{darkgray}\itshape\sffamily,
     stringstyle=\color{raspberry}\ttfamily,
     breaklines=true,
     breakatwhitespace=false,
     xleftmargin=1em,
     showstringspaces=false,
     caption={Example},
     captionpos=t
   }}
  {}


\lstdefinestyle{output}{
  basicstyle=\ttfamily\small,
  showstringspaces=false,
  breaklines=true,
  xleftmargin=1.5em
}

%% Table of contents

% Insert a group marker into the .toc file at the current position. The marker
% is rendered later, when LaTeX reads the .toc file, so headings such as "User
% guide" and "Reference" appear between the entries they group.
\newcommand{\sphinxtocgroup}[1]{%
  \addtocontents{toc}{\protect\sphinxtocgroupheading{#1}}%
}

% Render a ToC group heading between thin rules. The negative penalty provides
% a preferable page-break point before the heading; \nobreak keeps the heading
% attached to the entries that follow it.
\newcommand{\sphinxtocgroupheading}[1]{%
  \addpenalty{-1000}%
  \vspace{1.25em}%
  \noindent\rule{\linewidth}{0.4pt}\par
  \vspace{0.35em}%
  {\color{primary}\sffamily\bfseries\Large #1}\par
  \vspace{0.35em}%
  \noindent\rule{\linewidth}{0.4pt}\par
  \nobreak\vspace{0.6em}%
}

% Number chapters and appendices, but not their section headings
\setcounter{secnumdepth}{0}

% Draw the main "Contents" title between a heavy upper rule and a thin lower
% rule
\setlength{\cftbeforetoctitleskip}{0pt}
\renewcommand{\cfttoctitlefont}{%
  \color{primary}\par\noindent\rule{\linewidth}{1.2pt}\par
  \vspace{0.4em}\hfill\sffamily\bfseries\Huge
}
\renewcommand{\cftaftertoctitle}{%
  \par\vspace{0.4em}\noindent\rule{\linewidth}{0.4pt}\par
  \vspace{1em}%
}

\setlength{\cftbeforechapskip}{0.8em}

% Use semibold font for chapter and appendix ToC headings, set all headers color to primary
\renewcommand{\cftchapfont}{\color{primary}\sffamily\fontseries{sb}\selectfont}
\renewcommand{\cftchappagefont}{\color{primary}\sffamily\fontseries{sb}\selectfont}
\renewcommand{\cftsecfont}{\color{primary}}
\renewcommand{\cftsecpagefont}{\color{primary}}
\renewcommand{\cftsubsecfont}{\color{primary}}
\renewcommand{\cftsubsecpagefont}{\color{primary}}

% Rght-aligned page number column
\cftsetpnumwidth{2em}
\renewcommand{\cftpnumalign}{r}

% Reserve enough space for prefixes such as "Chapter 10:" and "Appendix A:"
\renewcommand{\cftchapaftersnum}{:}
\setlength{\cftchapnumwidth}{6.1em}

% Draw dotted lines for every ToC entry
\renewcommand{\cftchapleader}{{\color{riverblue}\cftdotfill{\cftdotsep}}}
\renewcommand{\cftsecleader}{{\color{riverblue}\cftdotfill{\cftdotsep}}}
\renewcommand{\cftsubsecleader}{{\color{riverblue}\cftdotfill{\cftdotsep}}}

% Keep section entries in the contents, but suppress the numeric prefix stored
% in each entry's \numberline. The group confines both overrides to the current
% section entry, leaving document headings and other ToC levels unchanged.
\makeatletter
\let\superbasic@l@section\l@section
\renewcommand{\l@section}[2]{%
  \begingroup
  \let\numberline\@gobble
  \setlength{\cftsecnumwidth}{0pt}%
  \superbasic@l@section{#1}{#2}%
  \endgroup
}
\makeatother

% Update the prefix written for subsequent chapter-level ToC entries. \@chapapp
% expands to the context-sensitive label ("Chapter" or "Appendix"). Writing the
% change into .toc applies it at the correct point when that file is read.
\makeatletter
\newcommand*\updatechaptername{%
	\addtocontents{toc}{\protect\renewcommand*\protect\cftchappresnum{\@chapapp\ }}
}
\makeatother

%%% Hyphenation
% Prefer adjusted word spacing before considering hyphenation.
\pretolerance=1000
\tolerance=1500
\emergencystretch=1em

% Permit hyphenation only when it substantially improves the paragraph.
\hyphenpenalty=3000
\exhyphenpenalty=3000

% Strongly discourage hyphenation on consecutive lines.
\doublehyphendemerits=100000
\finalhyphendemerits=50000

%%% Sphinx to LaTeX
% Keep styled roles intact in moving arguments such as headings and ToC entries,
% while exposing plain text to PDF bookmarks
\DeclareRobustCommand{\DUrolekwd}[1]{\texorpdfstring{\kwd{#1}}{#1}}
\DeclareRobustCommand{\DUroleasm}[1]{\texorpdfstring{\asm{#1}}{#1}}
\DeclareRobustCommand{\DUrolesep}[1]{%
  \texorpdfstring{{\normalfont\mdseries\color{riverblue}#1}}{#1}%
}
\renewcommand{\sphinxkeyboard}[1]{\keybd{#1}}
\renewcommand{\sphinxcode}[1]{\code{#1}}
